#include "driverlib.h"

#include "device.h"



#define I2C_BASE   I2CA_BASE

#define TMP117_ADDR 0x48



// TMP117 register pointer

#define TMP117_REG_TEMP   0x00



volatile float tempC = 0.0f;   // Watch/Expressions’dan izleyeceksin



static int i2c_waitStop(void)

{

    uint32_t to = 2000000;

    while(((I2C_getStatus(I2C_BASE) & I2C_STS_STOP_CONDITION) == 0) && (to--)) { }

    if(to == 0) return 0;



    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);

    return 1;

}



static int i2c_write1(uint16_t addr, uint8_t b0)

{

    I2C_setSlaveAddress(I2C_BASE, addr);

    I2C_setDataCount(I2C_BASE, 1);

    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);



    I2C_sendStartCondition(I2C_BASE);

    I2C_putData(I2C_BASE, b0);

    I2C_sendStopCondition(I2C_BASE);



    if(!i2c_waitStop()) return 0;



    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)

    {

        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);

        return 0;

    }

    return 1;

}



static int i2c_readN(uint16_t addr, uint8_t *buf, uint16_t n)

{

    uint16_t i;



    I2C_setSlaveAddress(I2C_BASE, addr);

    I2C_setDataCount(I2C_BASE, n);

    I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);



    I2C_sendStartCondition(I2C_BASE);

    I2C_sendStopCondition(I2C_BASE);



    for(i = 0; i < n; i++)

    {

        uint32_t to = 2000000;

        while((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0)

        {

            if(to-- == 0) return 0;

        }

        buf[i] = (uint8_t)I2C_getData(I2C_BASE);

    }



    if(!i2c_waitStop()) return 0;



    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)

    {

        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);

        return 0;

    }

    return 1;

}



static int tmp117_readTempC(float *outC)

{

    uint8_t rx[2];

    int16_t raw;



    // 1) Pointer register = TEMP(0x00)

    if(!i2c_write1(TMP117_ADDR, TMP117_REG_TEMP))

        return 0;



    // 2) 2 byte oku

    if(!i2c_readN(TMP117_ADDR, rx, 2))

        return 0;



    raw = (int16_t)((rx[0] << 8) | rx[1]);



    // TMP117 çözünürlük: 0.0078125 °C (1/128)

    *outC = (float)raw * 0.0078125f;

    return 1;

}



void main(void)

{

    Device_init();

    Device_initGPIO();



    // I2C pin mux: GPIO32 SDA, GPIO33 SCL

    GPIO_setPinConfig(GPIO_32_I2CA_SDA);

    GPIO_setPinConfig(GPIO_33_I2CA_SCL);



    I2C_disableModule(I2C_BASE);

    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);

    I2C_enableModule(I2C_BASE);



    while(1)

    {

        if(tmp117_readTempC((float*)&tempC))

        {

            // okundu -> tempC güncellendi

        }

        else

        {

            tempC = -999.0f; // iletişim yok işareti

        }



        DEVICE_DELAY_US(200000); // 200 ms

    }

}
