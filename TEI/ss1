#include "driverlib.h"
#include "device.h"

#define I2C_BASE          I2CB_BASE
#define TMP117_ADDR       0x48
#define TMP117_REG_TEMP   0x00

#define LED_GPIO          31   // ControlCARD D1 çoğunlukla GPIO31

volatile int16_t raw_temp = 0;
volatile float sicaklikC = -999.0f;
volatile uint16_t i2c_hata = 0;     // 0: OK, 1: timeout/stop yok, 2: NACK, 3: RX timeout

static int wait_stop_timeout(void)
{
    uint32_t to = 2000000;
    while(((I2C_getStatus(I2C_BASE) & I2C_STS_STOP_CONDITION) == 0) && (to--)) { }
    if(to == 0) return 0;

    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);
    return 1;
}

// 1 byte yaz (register pointer)
static int i2c_write1(uint16_t addr, uint8_t b0)
{
    // eski hataları temizle
    I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);

    I2C_setSlaveAddress(I2C_BASE, addr);
    I2C_setDataCount(I2C_BASE, 1);
    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);

    I2C_sendStartCondition(I2C_BASE);
    I2C_putData(I2C_BASE, b0);
    I2C_sendStopCondition(I2C_BASE);

    if(!wait_stop_timeout()) { i2c_hata = 1; return 0; }

    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        i2c_hata = 2;
        return 0;
    }

    i2c_hata = 0;
    return 1;
}

// 2 byte oku
static int i2c_read2(uint16_t addr, uint8_t *msb, uint8_t *lsb)
{
    uint32_t to;

    // eski hataları temizle
    I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);

    I2C_setSlaveAddress(I2C_BASE, addr);
    I2C_setDataCount(I2C_BASE, 2);
    I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);

    I2C_sendStartCondition(I2C_BASE);

    // 1. byte
    to = 2000000;
    while(((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0) && (to--)) { }
    if(to == 0) { i2c_hata = 3; return 0; }
    *msb = (uint8_t)I2C_getData(I2C_BASE);

    // 2. byte
    to = 2000000;
    while(((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0) && (to--)) { }
    if(to == 0) { i2c_hata = 3; return 0; }
    *lsb = (uint8_t)I2C_getData(I2C_BASE);

    I2C_sendStopCondition(I2C_BASE);

    if(!wait_stop_timeout()) { i2c_hata = 1; return 0; }

    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        i2c_hata = 2;
        return 0;
    }

    i2c_hata = 0;
    return 1;
}

static int tmp117_readTemp(float *outC)
{
    uint8_t msb, lsb;
    int16_t raw;

    // 1) pointer = 0x00
    if(!i2c_write1(TMP117_ADDR, TMP117_REG_TEMP))
        return 0;

    // 2) read 2 byte
    if(!i2c_read2(TMP117_ADDR, &msb, &lsb))
        return 0;

    raw = (int16_t)(((uint16_t)msb << 8) | (uint16_t)lsb);

    raw_temp = raw;
    *outC = (float)raw * 0.0078125f;   // 1/128 °C
    return 1;
}

void main(void)
{
    Device_init();
    Device_initGPIO();
    Interrupt_initModule();
    Interrupt_initVectorTable();

    // LED (D1) output
    GPIO_setDirectionMode(LED_GPIO, GPIO_DIR_MODE_OUT);
    GPIO_setPadConfig(LED_GPIO, GPIO_PIN_TYPE_STD);
    GPIO_writePin(LED_GPIO, 0);

    // I2C-B pins: GPIO40 SDA, GPIO41 SCL
    GPIO_setPinConfig(GPIO_40_I2CB_SDA);
    GPIO_setPadConfig(40, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(40, GPIO_QUAL_ASYNC);

    GPIO_setPinConfig(GPIO_41_I2CB_SCL);
    GPIO_setPadConfig(41, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(41, GPIO_QUAL_ASYNC);

    // I2C init
    I2C_disableModule(I2C_BASE);
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(I2C_BASE, I2C_BITCOUNT_8);
    I2C_enableModule(I2C_BASE);

    EINT;
    ERTM;

    while(1)
    {
        // Döngü çalışıyor mu? (LED blink)
        GPIO_togglePin(LED_GPIO);

        if(!tmp117_readTemp((float*)&sicaklikC))
        {
            // okuma başarısızsa sicaklikC -999 kalsın
            sicaklikC = -999.0f;
        }

        DEVICE_DELAY_US(500000); // 500 ms
    }
}
