#include "device.h"
#include "driverlib.h"
#include <stdint.h>

#define DS1302_RST_PIN   36U
#define DS1302_DAT_PIN   35U
#define DS1302_CLK_PIN   37U

#define DS1302_CMD_SECONDS_R   0x81U
#define DS1302_CMD_WP_W        0x8EU

uint8_t raw1 = 0;
uint8_t raw2 = 0;
uint8_t sec_dec = 0;
uint32_t loopSayaci = 0;

static void dly(void)
{
    DEVICE_DELAY_US(5);
}

static void rstH(void) { GPIO_writePin(DS1302_RST_PIN, 1); }
static void rstL(void) { GPIO_writePin(DS1302_RST_PIN, 0); }
static void clkH(void) { GPIO_writePin(DS1302_CLK_PIN, 1); }
static void clkL(void) { GPIO_writePin(DS1302_CLK_PIN, 0); }

static void datOut(void)
{
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_OUT);
}

static void datIn(void)
{
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_IN);
}

static void datW(uint16_t v)
{
    GPIO_writePin(DS1302_DAT_PIN, v);
}

static uint16_t datR(void)
{
    return GPIO_readPin(DS1302_DAT_PIN);
}

static uint8_t bcdToDec(uint8_t bcd)
{
    return (uint8_t)(((bcd >> 4U) * 10U) + (bcd & 0x0FU));
}

static void writeByte(uint8_t data)
{
    uint16_t i;

    datOut();

    for(i = 0; i < 8U; i++)
    {
        clkL();
        datW(data & 0x01U);
        dly();

        clkH();
        dly();

        data >>= 1U;
    }

    clkL();
}

static uint8_t readByte(void)
{
    uint16_t i;
    uint8_t data = 0U;

    datIn();

    for(i = 0; i < 8U; i++)
    {
        clkL();
        dly();

        clkH();
        dly();

        if(datR())
        {
            data |= (uint8_t)(1U << i);
        }
    }

    clkL();
    return data;
}

static void writeReg(uint8_t cmd, uint8_t val)
{
    rstL();
    clkL();
    dly();

    rstH();
    dly();

    writeByte(cmd);
    writeByte(val);

    rstL();
    clkL();
    dly();
}

static uint8_t readReg(uint8_t cmd)
{
    uint8_t val;

    rstL();
    clkL();
    dly();

    rstH();
    dly();

    writeByte(cmd);
    val = readByte();

    rstL();
    clkL();
    dly();

    return val;
}

static void ds1302_init_simple(void)
{
    GPIO_setDirectionMode(DS1302_RST_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(DS1302_CLK_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_OUT);

    GPIO_setPadConfig(DS1302_RST_PIN, GPIO_PIN_TYPE_STD);
    GPIO_setPadConfig(DS1302_CLK_PIN, GPIO_PIN_TYPE_STD);
    GPIO_setPadConfig(DS1302_DAT_PIN, GPIO_PIN_TYPE_STD);

    GPIO_setQualificationMode(DS1302_RST_PIN, GPIO_QUAL_ASYNC);
    GPIO_setQualificationMode(DS1302_CLK_PIN, GPIO_QUAL_ASYNC);
    GPIO_setQualificationMode(DS1302_DAT_PIN, GPIO_QUAL_ASYNC);

    rstL();
    clkL();
    datW(0);
    dly();

    writeReg(DS1302_CMD_WP_W, 0x00U);
}

void main(void)
{
    Device_init();
    Device_initGPIO();

    ds1302_init_simple();

    while(1)
    {
        raw1 = readReg(DS1302_CMD_SECONDS_R);
        raw2 = readReg(DS1302_CMD_SECONDS_R);

        sec_dec = bcdToDec(raw1 & 0x7FU);

        loopSayaci++;

        DEVICE_DELAY_US(500000);
    }
}