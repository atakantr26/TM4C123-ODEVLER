#include "driverlib.h"
#include "device.h"

// I2C-B Modülü ve Pinleri (GPIO 40/41)
#define I2C_BASE    I2CB_BASE
#define SLAVE_ADDR  0x48  // Sensör Adresi

// Değişkenler
int durum = 99;           // Hat Durumu (0: Boş/İyi, 1: Dolu/Kötü)
int iletisim_sonucu = 0;  // 1: Sensör Bulundu, 0: Sensör Yok

void main(void)
{
    Device_init();
    Device_initGPIO();
    Interrupt_initModule();
    Interrupt_initVectorTable();

    // --- 1. PIN AYARLARI (Senin çalışan ayarların) ---
    // GPIO 40 -> SDA (I2C-B)
    GPIO_setPinConfig(GPIO_40_I2CB_SDA);
    GPIO_setPadConfig(40, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(40, GPIO_QUAL_ASYNC);

    // GPIO 41 -> SCL (I2C-B)
    GPIO_setPinConfig(GPIO_41_I2CB_SCL);
    GPIO_setPadConfig(41, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(41, GPIO_QUAL_ASYNC);

    // --- 2. MODÜL AYARLARI (Defterindeki 2. ve 3. Adım) ---
    I2C_disableModule(I2C_BASE);
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(I2C_BASE, I2C_BIT_8);
    I2C_enableModule(I2C_BASE);

    EINT;
    ERTM;

    while(1)
    {
        // --- 3. HAT KONTROLÜ (Bu zaten çalışıyordu) ---
        if(I2C_isBusBusy(I2C_BASE))
        {
            durum = 1; // Hat meşgul (Kötü)
        }
        else
        {
            durum = 0; // Hat boş (İyi)

            // ====================================================
            // YENİ EKLENEN KISIM (Defterindeki 4, 5, 6, 7. Adımlar)
            // ====================================================
            
            // Adım 5: Slave Adresini Yaz
            I2C_setSlaveAddress(I2C_BASE, SLAVE_ADDR);

            // Adım 4 & 6: Master Mode ve Data Count (0 Byte veri, sadece adres)
            I2C_setDataCount(I2C_BASE, 0); 
            I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);

            // Adım 7: Start Condition (Başlat)
            I2C_sendStartCondition(I2C_BASE);
            I2C_sendStopCondition(I2C_BASE);

            // Sensörün cevap vermesi için minik bir bekleme
            DEVICE_DELAY_US(500);

            // Adım 10 (Benzeri): Hata Kontrolü (ACK geldi mi?)
            // I2CSTR register'ındaki NACK bitine bakıyoruz
            if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
            {
                iletisim_sonucu = 0; // HATA: Sensör cevap vermedi (NACK)
                I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK); // Hatayı temizle
            }
            else
            {
                iletisim_sonucu = 1; // BAŞARILI: Sensör cevap verdi (ACK)
            }
        }

        DEVICE_DELAY_US(100000); // Döngü hızı
    }
}
