#include "driverlib.h"
#include "device.h"

// =====================
// TMP117 (I2C) Ayarları
// =====================
#define TMP117_ADDR       0x48
#define TMP117_REG_TEMP   0x00

// I2C-B (GPIO40=SDA, GPIO41=SCL)
#define I2C_BASE          I2CB_BASE

// Debug/İzleme değişkenleri (CCS Expressions için)
volatile uint16_t ret_ok   = 0;
volatile uint16_t i2c_hata = 0;
volatile uint8_t  dbg_msb  = 0;
volatile uint8_t  dbg_lsb  = 0;

volatile int16_t raw_temp = 0;
volatile float   sicaklikC = 0.0f;

// =====================
// Basit I2C yardımcıları
// =====================
static inline void i2c_wait_stop(void)
{
    while((I2C_getStatus(I2C_BASE) & I2C_STS_STOP_CONDITION) == 0U) { }
    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);
}

static int i2c_write1(uint16_t slaveAddr, uint8_t regAddr)
{
    uint32_t st;

    I2C_setSlaveAddress(I2C_BASE, slaveAddr);
    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);
    I2C_setDataCount(I2C_BASE, 1);

    I2C_putData(I2C_BASE, regAddr);

    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);

    i2c_wait_stop();

    st = I2C_getStatus(I2C_BASE);
    if(st & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        return 0; // fail
    }
    return 1; // ok
}

static int i2c_read2(uint16_t slaveAddr, uint8_t *msb, uint8_t *lsb)
{
    uint32_t st;
    uint32_t timeout = 2000000UL;

    I2C_setSlaveAddress(I2C_BASE, slaveAddr);
    I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);
    I2C_setDataCount(I2C_BASE, 2);

    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);

    // 1. byte
    while(((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0U) && (timeout-- > 0U)) { }
    if(timeout == 0U) return 0;

    *msb = (uint8_t)I2C_getData(I2C_BASE);

    // 2. byte
    timeout = 2000000UL;
    while(((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0U) && (timeout-- > 0U)) { }
    if(timeout == 0U) return 0;

    *lsb = (uint8_t)I2C_getData(I2C_BASE);

    i2c_wait_stop();

    st = I2C_getStatus(I2C_BASE);
    if(st & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        return 0;
    }
    return 1;
}

// =====================
// TMP117 sıcaklık okuma
// =====================
static int tmp117_readTemp(float *outC)
{
    uint8_t msb, lsb;

    // 1) Temperature register adresini yaz
    if(!i2c_write1(TMP117_ADDR, TMP117_REG_TEMP))
    {
        i2c_hata = 1; // write/addr aşaması fail
        return 0;
    }

    // 2) 2 byte oku
    if(!i2c_read2(TMP117_ADDR, &msb, &lsb))
    {
        i2c_hata = 2; // read aşaması fail
        return 0;
    }

    // Debug için kaydet
    dbg_msb = msb;
    dbg_lsb = lsb;

    // 3) Birleştir ve °C çevir
    raw_temp = (int16_t)((((uint16_t)msb) << 8) | (uint16_t)lsb);
    *outC = (float)raw_temp * 0.0078125f; // 1 LSB = 7.8125 m°C

    i2c_hata = 0;
    return 1;
}

// =====================
// MAIN
// =====================
void main(void)
{
    Device_init();
    Device_initGPIO();

    // GPIO40 -> I2C-B SDA
    GPIO_setPinConfig(GPIO_40_I2CB_SDA);
    GPIO_setPadConfig(40, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(40, GPIO_QUAL_ASYNC);

    // GPIO41 -> I2C-B SCL
    GPIO_setPinConfig(GPIO_41_I2CB_SCL);
    GPIO_setPadConfig(41, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(41, GPIO_QUAL_ASYNC);

    // I2C Master Init (100 kHz)
    I2C_disableModule(I2C_BASE);
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(I2C_BASE, I2C_BITCOUNT_8);
    I2C_enableModule(I2C_BASE);

    DEVICE_DELAY_US(2000);

    while(1)
    {
        ret_ok = tmp117_readTemp((float*)&sicaklikC);

        if(ret_ok == 0U)
        {
            sicaklikC = -999.0f;
        }

        DEVICE_DELAY_US(200000); // 200 ms
    }
}
