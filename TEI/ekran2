#include "driverlib.h"
#include "device.h"
#include <stdio.h>

// --- AYARLAR ---
#define I2C_BASE        I2CA_BASE
#define SENSOR_ADDR     0x48
#define LCD_ADDR        0x27
#define ID_REG          0x0F  // Test için ID registerı (0x0117 döner)

// --- DEĞİŞKENLER ---
float sicaklik_C = 0.0;
int16_t ham_veri = 0;
char lcd_buffer[16];

// --- LCD YARDIMCI FONKSİYONLARI (FIFO UYUMLU) ---
void LCD_yaz(uint16_t veri, uint16_t mod) {
    uint16_t ust = (veri & 0xF0) | mod | 0x08; 
    uint16_t alt = ((veri << 4) & 0xF0) | mod | 0x08;

    I2C_setDataCount(I2C_BASE, 2);
    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);

    // TX FIFO boşalana kadar bekle ve gönder
    while(I2C_getTxFIFOStatus(I2C_BASE) != I2C_FIFO_TXEMPTY);
    I2C_putData(I2C_BASE, ust | 0x04);
    I2C_putData(I2C_BASE, ust);
    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);
    DEVICE_DELAY_US(1000);

    while(I2C_getTxFIFOStatus(I2C_BASE) != I2C_FIFO_TXEMPTY);
    I2C_putData(I2C_BASE, alt | 0x04);
    I2C_putData(I2C_BASE, alt);
    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);
    DEVICE_DELAY_US(1000);
}

void LCD_komut(uint16_t cmd) { LCD_yaz(cmd, 0); }
void LCD_veri(uint16_t dat)  { LCD_yaz(dat, 1); }

void LCD_baslat() {
    DEVICE_DELAY_US(50000);
    LCD_komut(0x03); DEVICE_DELAY_US(5000);
    LCD_komut(0x02); // 4-bit mod
    LCD_komut(0x28); // 2 Satır
    LCD_komut(0x0C); // Ekran açık
    LCD_komut(0x01); // Temizle
    DEVICE_DELAY_US(2000);
}

void LCD_yazi_yaz(char *s) {
    while(*s) LCD_veri(*s++);
}

void main(void)
{
    Device_init();
    Device_initGPIO();
    Interrupt_initModule();
    Interrupt_initVectorTable();

    // --- GPIO AYARLARI (32-33) ---
    GPIO_setPinConfig(GPIO_32_I2CA_SDA); 
    GPIO_setPadConfig(32, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(32, GPIO_QUAL_ASYNC);

    GPIO_setPinConfig(GPIO_33_I2CA_SCL);
    GPIO_setPadConfig(33, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(33, GPIO_QUAL_ASYNC);

    // --- I2C-A MODÜL & FIFO AYARLARI ---
    I2C_disableModule(I2C_BASE);
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(I2C_BASE, I2C_BIT_8);
    
    // FIFO Aktif Etme
    I2C_enableFIFO(I2C_BASE);
    I2C_clearInterruptStatus(I2C_BASE, I2C_INT_RXFF | I2C_INT_TXFF);
    
    I2C_setEmulationMode(I2C_BASE, I2C_EMULATION_FREE_RUN);
    I2C_enableModule(I2C_BASE);

    EINT; ERTM;

    // LCD Başlat
    I2C_setSlaveAddress(I2C_BASE, LCD_ADDR);
    LCD_baslat();

    while(1)
    {
        // --- 1. SENSÖR OKUMA (FIFO İLE) ---
        I2C_setSlaveAddress(I2C_BASE, SENSOR_ADDR);
        
        // Register adresini gönder (0x00)
        I2C_setDataCount(I2C_BASE, 1);
        I2C_putData(I2C_BASE, 0x00);
        I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);
        I2C_sendStartCondition(I2C_BASE);
        I2C_sendStopCondition(I2C_BASE);
        DEVICE_DELAY_US(1000);

        // 2 Byte Oku
        I2C_setDataCount(I2C_BASE, 2);
        I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);
        I2C_sendStartCondition(I2C_BASE);
        I2C_sendStopCondition(I2C_BASE);

        // FIFO'da 2 byte birikene kadar bekle (Donmayı engeller)
        while(I2C_getRxFIFOStatus(I2C_BASE) < I2C_FIFO_RX2);

        uint16_t msb = I2C_getData(I2C_BASE);
        uint16_t lsb = I2C_getData(I2C_BASE);

        ham_veri = (int16_t)((msb << 8) | lsb);
        sicaklik_C = (float)ham_veri * 0.0078125;

        // --- 2. LCD GÜNCELLEME (FIFO İLE) ---
        I2C_setSlaveAddress(I2C_BASE, LCD_ADDR);
        
        LCD_komut(0x80); 
        LCD_yazi_yaz("TI-C2000 FIFO");
        
        LCD_komut(0xC0);
        sprintf(lcd_buffer, "Temp:%.2f C", sicaklik_C);
        LCD_yazi_yaz(lcd_buffer);

        DEVICE_DELAY_US(500000); // 500ms bekle
    }
}
