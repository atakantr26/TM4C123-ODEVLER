#ifndef HAL_RTC_H_
#define HAL_RTC_H_

#include "driverlib.h"
#include "device.h"

#define RST_PIN 13
#define DAT_PIN 14
#define CLK_PIN 15

void HAL_RTC_GpioInit(void);
uint16_t HAL_RTC_Xfer(uint16_t data, bool is_read);
void HAL_RTC_SetRst(bool state);

#endif




#include "hal_rtc.h"

void HAL_RTC_GpioInit(void) {
    GPIO_setDirectionMode(RST_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(CLK_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(DAT_PIN, GPIO_DIR_MODE_OUT);
    GPIO_writePin(RST_PIN, 0);
    GPIO_writePin(CLK_PIN, 0);
}

void HAL_RTC_SetRst(bool state) {
    GPIO_writePin(RST_PIN, state);
    DEVICE_DELAY_US(10);
}

uint16_t HAL_RTC_Xfer(uint16_t data, bool is_read) {
    int i;
    uint16_t read_val = 0;
    for(i = 0; i < 8; i++) {
        if(!is_read) GPIO_writePin(DAT_PIN, (data >> i) & 0x01);
        else if(GPIO_readPin(DAT_PIN)) read_val |= (1 << i);

        GPIO_writePin(CLK_PIN, 1); DEVICE_DELAY_US(15);
        GPIO_writePin(CLK_PIN, 0); DEVICE_DELAY_US(15);
    }
    return read_val;
}




#ifndef BSP_DS1302_H_
#define BSP_DS1302_H_

#include "hal_rtc.h"

typedef struct {
    uint16_t saniye;
    uint16_t dakika;
    uint16_t saat;
} RTC_Time;

void BSP_DS1302_Init(void);
RTC_Time BSP_DS1302_GetTime(void);

#endif



#include "bsp_ds1302.h"

void BSP_DS1302_Init(void) {
    HAL_RTC_GpioInit();
    
    // Yazma Korumasını Kaldır ve Başlat
    HAL_RTC_SetRst(1);
    HAL_RTC_Xfer(0x8E, false); HAL_RTC_Xfer(0x00, false);
    HAL_RTC_SetRst(0);

    HAL_RTC_SetRst(1);
    HAL_RTC_Xfer(0x80, false); HAL_RTC_Xfer(0x00, false); // Saniye 00
    HAL_RTC_SetRst(0);
}

RTC_Time BSP_DS1302_GetTime(void) {
    RTC_Time t;
    uint16_t raw_s, raw_m, raw_h;

    // Saniye oku
    HAL_RTC_SetRst(1);
    HAL_RTC_Xfer(0x81, false);
    GPIO_setDirectionMode(DAT_PIN, GPIO_DIR_MODE_IN);
    raw_s = HAL_RTC_Xfer(0, true);
    GPIO_setDirectionMode(DAT_PIN, GPIO_DIR_MODE_OUT);
    HAL_RTC_SetRst(0);

    // Dakika oku
    HAL_RTC_SetRst(1);
    HAL_RTC_Xfer(0x83, false);
    GPIO_setDirectionMode(DAT_PIN, GPIO_DIR_MODE_IN);
    raw_m = HAL_RTC_Xfer(0, true);
    GPIO_setDirectionMode(DAT_PIN, GPIO_DIR_MODE_OUT);
    HAL_RTC_SetRst(0);

    // BCD to DEC dönüşümü
    t.saniye = (raw_s & 0x0F) + ((raw_s >> 4) * 10);
    t.dakika = (raw_m & 0x0F) + ((raw_m >> 4) * 10);
    
    return t;
}



#include "driverlib.h"
#include "device.h"
#include "bsp_ds1302.h"

RTC_Time su anki_zaman;
uint32_t loop_sayaci = 0;

void main(void) {
    Device_init();
    Device_initGPIO();
    
    // DS1302 Katmanlı Yapıyı Başlat
    BSP_DS1302_Init();

    while(1) {
        su anki_zaman = BSP_DS1302_GetTime();
        
        loop_sayaci++;
        DEVICE_DELAY_US(1000000); // 1 saniye bekle
    }
}



