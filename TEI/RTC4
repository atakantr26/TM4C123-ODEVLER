#include "device.h"
#include "driverlib.h"
#include <stdint.h>

/* =========================
   DS1302 PIN TANIMLARI
   ========================= */
#define DS1302_RST_PIN   36U
#define DS1302_DAT_PIN   35U
#define DS1302_CLK_PIN   37U

/* =========================
   DS1302 KOMUTLARI
   ========================= */
#define DS1302_CMD_SECONDS_W   0x80U
#define DS1302_CMD_SECONDS_R   0x81U
#define DS1302_CMD_WP_W        0x8EU

/* =========================
   GLOBAL DEĞİŞKENLER
   Watch/Expressions'tan izle
   ========================= */
uint8_t sec_raw = 0;
uint8_t sec_dec = 0;
uint32_t loopSayaci = 0;

/* =========================
   KÜÇÜK DELAY
   ========================= */
static void DS1302_delay(void)
{
    DEVICE_DELAY_US(5);
}

/* =========================
   PIN KONTROL FONKSİYONLARI
   ========================= */
static void DS1302_RST_High(void)
{
    GPIO_writePin(DS1302_RST_PIN, 1);
}

static void DS1302_RST_Low(void)
{
    GPIO_writePin(DS1302_RST_PIN, 0);
}

static void DS1302_CLK_High(void)
{
    GPIO_writePin(DS1302_CLK_PIN, 1);
}

static void DS1302_CLK_Low(void)
{
    GPIO_writePin(DS1302_CLK_PIN, 0);
}

static void DS1302_DAT_Output(void)
{
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_OUT);
}

static void DS1302_DAT_Input(void)
{
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_IN);
}

static void DS1302_DAT_Write(uint16_t value)
{
    GPIO_writePin(DS1302_DAT_PIN, value);
}

static uint16_t DS1302_DAT_Read(void)
{
    return GPIO_readPin(DS1302_DAT_PIN);
}

/* =========================
   BCD -> DEC
   ========================= */
static uint8_t BCD_to_DEC(uint8_t bcd)
{
    return (uint8_t)(((bcd >> 4U) * 10U) + (bcd & 0x0FU));
}

/* =========================
   1 BYTE YAZ (LSB FIRST)
   DS1302 veriyi LSB first ister
   ========================= */
static void DS1302_WriteByte(uint8_t data)
{
    uint16_t i;

    DS1302_DAT_Output();

    for(i = 0; i < 8U; i++)
    {
        /* En düşük bit önce gönderilir */
        DS1302_DAT_Write(data & 0x01U);
        DS1302_delay();

        /* Clock darbesi */
        DS1302_CLK_High();
        DS1302_delay();

        DS1302_CLK_Low();
        DS1302_delay();

        data >>= 1U;
    }
}

/* =========================
   1 BYTE OKU (LSB FIRST)
   ========================= */
static uint8_t DS1302_ReadByte(void)
{
    uint16_t i;
    uint8_t data = 0U;

    DS1302_DAT_Input();

    for(i = 0; i < 8U; i++)
    {
        /* Önce clock yükseltilir */
        DS1302_CLK_High();
        DS1302_delay();

        /* Bit okunur */
        if(DS1302_DAT_Read())
        {
            data |= (uint8_t)(1U << i);
        }

        DS1302_CLK_Low();
        DS1302_delay();
    }

    return data;
}

/* =========================
   REGISTER YAZ
   ========================= */
static void DS1302_WriteRegister(uint8_t cmd, uint8_t value)
{
    DS1302_RST_Low();
    DS1302_CLK_Low();
    DS1302_delay();

    DS1302_RST_High();
    DS1302_delay();

    DS1302_WriteByte(cmd);
    DS1302_WriteByte(value);

    DS1302_RST_Low();
    DS1302_delay();
}

/* =========================
   REGISTER OKU
   ========================= */
static uint8_t DS1302_ReadRegister(uint8_t cmd)
{
    uint8_t value;

    DS1302_RST_Low();
    DS1302_CLK_Low();
    DS1302_delay();

    DS1302_RST_High();
    DS1302_delay();

    DS1302_WriteByte(cmd);
    value = DS1302_ReadByte();

    DS1302_RST_Low();
    DS1302_delay();

    return value;
}

/* =========================
   DS1302 BAŞLATMA
   ========================= */
static void DS1302_Init(void)
{
    /* GPIO yönleri */
    GPIO_setDirectionMode(DS1302_RST_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(DS1302_CLK_PIN, GPIO_DIR_MODE_OUT);
    GPIO_setDirectionMode(DS1302_DAT_PIN, GPIO_DIR_MODE_OUT);

    /* Pad ayarları */
    GPIO_setPadConfig(DS1302_RST_PIN, GPIO_PIN_TYPE_STD);
    GPIO_setPadConfig(DS1302_CLK_PIN, GPIO_PIN_TYPE_STD);
    GPIO_setPadConfig(DS1302_DAT_PIN, GPIO_PIN_TYPE_STD);

    /* Qualification */
    GPIO_setQualificationMode(DS1302_RST_PIN, GPIO_QUAL_ASYNC);
    GPIO_setQualificationMode(DS1302_CLK_PIN, GPIO_QUAL_ASYNC);
    GPIO_setQualificationMode(DS1302_DAT_PIN, GPIO_QUAL_ASYNC);

    /* Başlangıç seviyeleri */
    DS1302_RST_Low();
    DS1302_CLK_Low();
    DS1302_DAT_Write(0);
    DS1302_delay();

    /* Write protect kapat */
    DS1302_WriteRegister(DS1302_CMD_WP_W, 0x00U);
    DS1302_delay();

    /* Seconds register oku, CH bitini temizle, geri yaz */
    sec_raw = DS1302_ReadRegister(DS1302_CMD_SECONDS_R);
    sec_raw &= 0x7FU;
    DS1302_WriteRegister(DS1302_CMD_SECONDS_W, sec_raw);
    DS1302_delay();
}

/* =========================
   MAIN
   ========================= */
void main(void)
{
    Device_init();
    Device_initGPIO();

    DS1302_Init();

    while(1)
    {
        sec_raw = DS1302_ReadRegister(DS1302_CMD_SECONDS_R);
        sec_dec = BCD_to_DEC(sec_raw & 0x7FU);

        loopSayaci++;

        DEVICE_DELAY_US(500000);
    }
}