DS1302_Time rtcTime;
uint32_t loopSayaci = 0;

void main(void)
{
    Device_init();
    Device_initGPIO();

    DS1302_init();

    /* İlk kurulumda bir kere açıp zamanı set edebilirsin */
    /*
