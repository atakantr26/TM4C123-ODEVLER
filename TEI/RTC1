    ayar.month   = 3;
    ayar.day     = 1;   // 1-7
    ayar.year    = 26;  // 2026 -> 26
    DS1302_setTime(&ayar);
    */

    while(1)
    {
        DS1302_getTime(&rtcTime);
        loopSayaci++;

        DEVICE_DELAY_US(500000); /* 500 ms */
    }
}