#ifndef DS1302_H
#define DS1302_H

#include <stdint.h>

typedef struct
{
    uint8_t seconds;
    uint8_t minutes;
    uint8_t hours;
    uint8_t date;
    uint8_t month;
    uint8_t day;
    uint8_t year;
} DS1302_Time;

void DS1302_init(void);
void DS1302_disableWriteProtect(void);
void DS1302_enableWriteProtect(void);
void DS1302_setTime(const DS1302_Time *time);
void DS1302_getTime(DS1302_Time *time);

uint8_t DS1302_readRegister(uint8_t cmdRead);
void DS1302_writeRegister(uint8_t cmdWrite, uint8_t data);

#endif


