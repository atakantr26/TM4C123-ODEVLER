#ifndef TEI_I2C_HAL_H
#define TEI_I2C_HAL_H

#include <stdint.h>

void TEI_I2C_init(void);

void TEI_I2C_setSlaveAddress(uint16_t slaveAddr);

void TEI_I2C_setSendMode(void);
void TEI_I2C_setReceiveMode(void);

void TEI_I2C_setDataCount(uint16_t count);

void TEI_I2C_putData(uint16_t data);
uint16_t TEI_I2C_getData(void);

void TEI_I2C_sendStart(void);
void TEI_I2C_sendStop(void);

uint16_t TEI_I2C_getStopStatus(void);
uint16_t TEI_I2C_getRxFIFOStatus(void);

#endif




#include "device.h"
#include "driverlib.h"
#include "tei_i2c_hal.h"

#define TEI_I2C_BASE I2CB_BASE

void TEI_I2C_init(void)
{
    GPIO_setPinConfig(GPIO_40_I2CB_SDA);
    GPIO_setPadConfig(40, GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(40, GPIO_QUAL_ASYNC);

    GPIO_setPinConfig(GPIO_41_I2CB_SCL);
    GPIO_setPadConfig(41, GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(41, GPIO_QUAL_ASYNC);

    I2C_disableModule(TEI_I2C_BASE);
    I2C_initMaster(TEI_I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(TEI_I2C_BASE, I2C_BITCOUNT_8);
    I2C_enableFIFO(TEI_I2C_BASE);
    I2C_enableModule(TEI_I2C_BASE);
}

void TEI_I2C_setSlaveAddress(uint16_t slaveAddr)
{
    I2C_setSlaveAddress(TEI_I2C_BASE, slaveAddr);
}

void TEI_I2C_setSendMode(void)
{
    I2C_setConfig(TEI_I2C_BASE, I2C_MASTER_SEND_MODE);
}

void TEI_I2C_setReceiveMode(void)
{
    I2C_setConfig(TEI_I2C_BASE, I2C_MASTER_RECEIVE_MODE);
}

void TEI_I2C_setDataCount(uint16_t count)
{
    I2C_setDataCount(TEI_I2C_BASE, count);
}

void TEI_I2C_putData(uint16_t data)
{
    I2C_putData(TEI_I2C_BASE, data);
}

uint16_t TEI_I2C_getData(void)
{
    return I2C_getData(TEI_I2C_BASE);
}

void TEI_I2C_sendStart(void)
{
    I2C_sendStartCondition(TEI_I2C_BASE);
}

void TEI_I2C_sendStop(void)
{
    I2C_sendStopCondition(TEI_I2C_BASE);
}

uint16_t TEI_I2C_getStopStatus(void)
{
    return I2C_getStopConditionStatus(TEI_I2C_BASE);
}

uint16_t TEI_I2C_getRxFIFOStatus(void)
{
    return I2C_getRxFIFOStatus(TEI_I2C_BASE);
}