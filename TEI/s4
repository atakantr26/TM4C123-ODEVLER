// =============================================================
// C2000 F28388D + TMP117 I2C Okuma Kodu (Polling Yöntemi)
// Pinler: Pin 85 (GPIO32/SDA) ve Pin 87 (GPIO33/SCL)
// =============================================================

#include "driverlib.h"
#include "device.h"

// --- AYARLAR ---
// DİKKAT: Sensör çalışmazsa adresi 0x49 yap!
#define TMP117_ADDR         0x48  
#define TMP117_TEMP_REG     0x00  
#define I2C_BASE            I2CA_BASE

// --- GLOBAL DEĞİŞKENLER (Expressions ekranına ekle) ---
float sicaklik_C = 0.0f;
int16_t ham_veri = 0;
uint16_t hata_durumu = 0; // 0: OK, 1: NACK (Adres Hatası), 2: Timeout (Kablo Kopuk)

// Fonksiyon Prototipleri
void initI2C(void);
float readTMP117(void);

void main(void)
{
    // 1. Sistem Başlatma
    Device_init();
    Device_initGPIO();

    // 2. Interruptları Temizle
    Interrupt_initModule();
    Interrupt_initVectorTable();

    // 3. I2C Başlat
    initI2C();

    // 4. Global Interruptları Aç
    EINT;
    ERTM;

    // Sonsuz Döngü
    while(1)
    {
        // Sıcaklığı Oku
        float sonuc = readTMP117();

        // Eğer hata yoksa değeri güncelle
        if(hata_durumu == 0)
        {
            sicaklik_C = sonuc;
        }
        else
        {
            // Hata varsa -100.0 veya son değeri koru
            // Debug yaparken 0.0 ile karismamasi icin -999 yapiyoruz
            sicaklik_C = -999.0f; 
        }

        // 500ms Bekle
        DEVICE_DELAY_US(500000);
    }
}

void initI2C(void)
{
    // --- GPIO AYARLARI (Pin 85 ve 87) ---
    // GPIO32 -> SDA (Pin 85)
    GPIO_setPinConfig(GPIO_32_I2CA_SDA);
    GPIO_setPadConfig(32, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(32, GPIO_QUAL_ASYNC);

    // GPIO33 -> SCL (Pin 87)
    GPIO_setPinConfig(GPIO_33_I2CA_SCL);
    GPIO_setPadConfig(33, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(33, GPIO_QUAL_ASYNC);

    // --- I2C MODÜL AYARLARI ---
    I2C_disableModule(I2C_BASE);
    
    // 100kHz Hız Ayarı (Sistem saatine göre otomatik hesaplar)
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    
    // 8-Bit, Adres ve Mod Ayarı
    I2C_setSlaveAddress(I2C_BASE, TMP117_ADDR);
    I2C_setEmulationMode(I2C_BASE, I2C_EMULATION_FREE_RUN);
    
    I2C_enableModule(I2C_BASE);
}

float readTMP117(void)
{
    uint16_t msb, lsb;
    uint32_t timeout = 10000; // Sonsuz döngüden kaçış bileti

    // --- ADIM 1: Register Adresini Yaz (0x00) ---
    
    // Bus'ın boşalmasını bekle (Timeout korumalı)
    while(I2C_getStopConditionStatus(I2C_BASE) && timeout > 0) { timeout--; }
    if(timeout == 0) { hata_durumu = 2; return 0.0f; } // HATA: Bus Kilitli

    I2C_setSlaveAddress(I2C_BASE, TMP117_ADDR);
    I2C_setDataCount(I2C_BASE, 1);
    I2C_putData(I2C_BASE, TMP117_TEMP_REG);
    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);
    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);

    // İşlemin bitmesini bekle
    timeout = 10000;
    while(I2C_getStopConditionStatus(I2C_BASE) && timeout > 0) { timeout--; }
    
    // NACK Kontrolü (Sensör cevap verdi mi?)
    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        hata_durumu = 1; // HATA: Sensör Yok (Adres yanlış veya kablo çıkık)
        return 0.0f;
    }

    // --- ADIM 2: Veriyi Oku (2 Byte) ---
    I2C_setDataCount(I2C_BASE, 2);
    I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);
    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);

    // MSB Bekle
    timeout = 10000;
    while(!(I2C_getStatus(I2C_BASE) & I2C_STS_REG_ACCESS_RDY) && timeout > 0) { timeout--; }
    if(timeout == 0) { hata_durumu = 2; return 0.0f; }
    msb = I2C_getData(I2C_BASE);

    // LSB Bekle
    timeout = 10000;
    while(!(I2C_getStatus(I2C_BASE) & I2C_STS_REG_ACCESS_RDY) && timeout > 0) { timeout--; }
    if(timeout == 0) { hata_durumu = 2; return 0.0f; }
    lsb = I2C_getData(I2C_BASE);

    // --- SONUÇ ---
    hata_durumu = 0; // Başarılı
    ham_veri = (int16_t)((msb << 8) | lsb);
    return (float)ham_veri * 0.0078125f;
}
