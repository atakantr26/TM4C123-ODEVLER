#include "driverlib.h"
#include "device.h"

// I2C-B Modülü ve Pinleri (GPIO 40/41)
#define I2C_BASE      I2CB_BASE
#define SLAVE_ADDR    0x48   // TMP117 default address

// TMP117 register
#define TMP117_REG_TEMP   0x00

// Değişkenler (debug için)
volatile int durum = 99;            // 0: Bus boş/iyi, 1: Bus meşgul/kötü
volatile int iletisim_sonucu = 0;   // 1: ACK geldi, 0: NACK
volatile int okuma_sonucu = 0;      // 1: sıcaklık okundu, 0: okunamadı
volatile int i2c_hata = 0;          // 0: yok, 1: var

volatile int16_t tmp_raw = 0;
volatile float sicaklikC = 0.0f;

// STOP flag bekle (timeout'lu)
static int wait_stop(void)
{
    uint32_t to = 2000000;

    while(((I2C_getStatus(I2C_BASE) & I2C_STS_STOP_CONDITION) == 0) && (to--)) { }

    if(to == 0)
        return 0;

    I2C_clearStatus(I2C_BASE, I2C_STS_STOP_CONDITION);
    return 1;
}

// 1 byte yaz (register pointer vs.)
static int i2c_write1(uint16_t addr, uint8_t b0)
{
    I2C_setSlaveAddress(I2C_BASE, addr);
    I2C_setDataCount(I2C_BASE, 1);
    I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);

    I2C_sendStartCondition(I2C_BASE);
    I2C_putData(I2C_BASE, b0);
    I2C_sendStopCondition(I2C_BASE);

    if(!wait_stop()) return 0;

    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        return 0;
    }
    return 1;
}

// N byte oku
static int i2c_readN(uint16_t addr, uint8_t *buf, uint16_t n)
{
    uint16_t i;

    I2C_setSlaveAddress(I2C_BASE, addr);
    I2C_setDataCount(I2C_BASE, n);
    I2C_setConfig(I2C_BASE, I2C_MASTER_RECEIVE_MODE);

    I2C_sendStartCondition(I2C_BASE);
    I2C_sendStopCondition(I2C_BASE);

    for(i = 0; i < n; i++)
    {
        uint32_t to = 2000000;
        while((I2C_getStatus(I2C_BASE) & I2C_STS_RX_DATA_RDY) == 0)
        {
            if(to-- == 0) return 0;
        }
        buf[i] = (uint8_t)I2C_getData(I2C_BASE);
    }

    if(!wait_stop()) return 0;

    if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
    {
        I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
        return 0;
    }
    return 1;
}

// TMP117 sıcaklık oku (0x00 -> 2 byte -> °C)
static int tmp117_readTemp(float *outC)
{
    uint8_t rx[2];
    int16_t raw;

    // 1) Temperature register pointer
    if(!i2c_write1(SLAVE_ADDR, TMP117_REG_TEMP))
        return 0;

    // 2) Read 2 bytes
    if(!i2c_readN(SLAVE_ADDR, rx, 2))
        return 0;

    raw = (int16_t)((rx[0] << 8) | rx[1]);

    tmp_raw = raw;
    *outC = (float)raw * 0.0078125f;   // 1/128 °C
    return 1;
}

void main(void)
{
    Device_init();
    Device_initGPIO();
    Interrupt_initModule();
    Interrupt_initVectorTable();

    // --- 1. PIN AYARLARI (Senin çalışan ayarların) ---
    // GPIO 40 -> SDA (I2C-B)
    GPIO_setPinConfig(GPIO_40_I2CB_SDA);
    GPIO_setPadConfig(40, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(40, GPIO_QUAL_ASYNC);

    // GPIO 41 -> SCL (I2C-B)
    GPIO_setPinConfig(GPIO_41_I2CB_SCL);
    GPIO_setPadConfig(41, GPIO_PIN_TYPE_OD | GPIO_PIN_TYPE_PULLUP);
    GPIO_setQualificationMode(41, GPIO_QUAL_ASYNC);

    // --- 2. MODÜL AYARLARI ---
    I2C_disableModule(I2C_BASE);
    I2C_initMaster(I2C_BASE, DEVICE_SYSCLK_FREQ, 100000, I2C_DUTYCYCLE_50);
    I2C_setBitCount(I2C_BASE, I2C_BIT_8);
    I2C_enableModule(I2C_BASE);

    EINT;
    ERTM;

    while(1)
    {
        // --- 3. HAT KONTROLÜ ---
        if(I2C_isBusBusy(I2C_BASE))
        {
            durum = 1; // Bus meşgul
        }
        else
        {
            durum = 0; // Bus boş

            // --- 4. SENSÖR VAR MI? (ACK/NACK) ---
            // Senin yaklaşımı koruyalım: 0 byte ile sadece adres yokla
            I2C_setSlaveAddress(I2C_BASE, SLAVE_ADDR);
            I2C_setDataCount(I2C_BASE, 0);
            I2C_setConfig(I2C_BASE, I2C_MASTER_SEND_MODE);

            I2C_sendStartCondition(I2C_BASE);
            I2C_sendStopCondition(I2C_BASE);

            // STOP'u beklemek daha doğru (DEVICE_DELAY yerine)
            if(!wait_stop())
            {
                iletisim_sonucu = 0;
                i2c_hata = 1;
            }
            else
            {
                if(I2C_getStatus(I2C_BASE) & I2C_STS_NO_ACK)
                {
                    iletisim_sonucu = 0;
                    I2C_clearStatus(I2C_BASE, I2C_STS_NO_ACK);
                }
                else
                {
                    iletisim_sonucu = 1;
                }

                // --- 5. ACK geldiyse sıcaklık oku ---
                if(iletisim_sonucu == 1)
                {
                    okuma_sonucu = tmp117_readTemp((float*)&sicaklikC);
                    i2c_hata = (okuma_sonucu == 1) ? 0 : 1;
                    if(okuma_sonucu == 0)
                        sicaklikC = -999.0f;
                }
                else
                {
                    okuma_sonucu = 0;
                    sicaklikC = -999.0f;
                }
            }
        }

        DEVICE_DELAY_US(200000); // 200 ms
    }
}
